# Google Street View / Geocoding. Required only for real API calls; importing
# the package and running the unit suite never touches the network.
GOOGLE_API_KEY=

# Logging
UC_DEBUG=0
UC_LOG_LEVEL=INFO
UC_LOG_FORMAT=text
UC_LOG_FILE=

# Segmentation defaults
UC_SEG_BACKEND=oneformer
UC_SEG_MODEL=
UC_SEG_TASK=semantic
UC_DEVICE=auto
UC_TAXONOMY=

# Detectron2 (COCO panoptic model from the model zoo).
UC_D2_SCORE_THRESH=0.5

# DeepLab backend. These are properties of the machine, not of a run: set them
# once and --ckpt / --deeplab-repo / --deeplab-model become optional, still
# overriding when passed on the command line.
UC_DEEPLAB_CKPT=
UC_DEEPLAB_REPO=
UC_DEEPLAB_MODEL=
UC_TRUST_CHECKPOINT=0

# Web API
# Bearer authentication. Empty means no authentication at all, which is fine on
# localhost and reckless anywhere else: every caller can spend the Google quota
# above. Comma-separated, so tokens can be revoked one at a time.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UC_API_TOKENS=
UC_API_MAX_CONCURRENCY=1
UC_API_QUEUE_TIMEOUT_S=300
UC_API_CORS_ORIGINS=*
# Ceiling on how many views may carry base64 overlays in one
# /analyse/multi response. Each view adds roughly 3 MB.
UC_API_MAX_OVERLAY_VIEWS=8

# Model caches
TORCH_HOME=
HF_HOME=
